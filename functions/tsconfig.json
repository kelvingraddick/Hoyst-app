{
  "compilerOptions": {
    "declaration": false,
    "esModuleInterop": true,
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmitOnError": true,
    "noImplicitReturns": true,
    "noUnusedLocals": false,
    "outDir": "lib",
    "rootDir": "src",
    "strict": true,
    "target": "ES2022"
  },
  "compileOnSave": true,
  "include": ["src"]
}
