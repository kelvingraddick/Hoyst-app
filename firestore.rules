rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function isActiveMember(circleId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.status == 'active';
    }

    function isCircleMember(circleId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/circles/$(circleId)/members/$(request.auth.uid)).data.status in ['active', 'pending'];
    }

    function isGroupCircle(circleId) {
      return get(/databases/$(database)/documents/circles/$(circleId)).data.get('circleMode', 'group') == 'group';
    }

    function isActiveCircle(circleId) {
      return get(/databases/$(database)/documents/circles/$(circleId)).data.get('lifecycleStatus', 'active') == 'active';
    }

    function isPublicCircle() {
      return resource.data.privacy == 'public' &&
        resource.data.get('circleMode', 'group') == 'group' &&
        resource.data.get('lifecycleStatus', 'active') == 'active';
    }

    function marksReadAtOnly() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['readAt']) &&
        request.resource.data.readAt == request.time;
    }

    match /users/{uid} {
      allow read: if true;
      allow create, delete: if false;
      allow update: if isSelf(uid) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['avatarUrl', 'bio', 'displayName', 'updatedAt']);
    }

    match /userPrivate/{uid} {
      allow read: if isSelf(uid);
      allow create, update, delete: if false;

      match /inbox/{eventId} {
        allow read: if isSelf(uid);
        allow update: if isSelf(uid) && marksReadAtOnly();
        allow create, delete: if false;
      }

      match /opportunities/{opportunityId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /momentum/{summaryId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }

      match /pastCircles/{circleId} {
        allow read: if isSelf(uid);
        allow write: if false;
      }
    }

    match /handles/{handle} {
      allow read: if true;
      allow write: if false;
    }

    match /publicCircleIndex/{circleId} {
      allow read: if resource.data.get('circleMode', 'group') == 'group' &&
        resource.data.get('lifecycleStatus', 'active') == 'active';
      allow write: if false;
    }

    match /{path=**}/members/{uid} {
      allow read: if isSelf(uid) || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    match /circles/{circleId} {
      allow read: if isPublicCircle() || isCircleMember(circleId);
      allow write: if false;

      match /members/{uid} {
        allow read: if isActiveMember(circleId) || isSelf(uid);
        allow write: if false;
      }

      match /membershipHistory/{uid} {
        allow read: if isSelf(uid);
        allow write: if false;

        match /periods/{periodId} {
          allow read: if isSelf(uid);
          allow write: if false;
        }
      }

      match /joinRequests/{uid} {
        allow read: if isSelf(uid) || isActiveMember(circleId);
        allow write: if false;
      }

      match /days/{dateKey} {
        allow read: if isActiveMember(circleId);
        allow write: if false;

        match /checkIns/{uid} {
          allow read: if isActiveMember(circleId) || isSelf(uid);
          allow write: if false;
        }
      }

      match /opportunities/{periodKey} {
        allow read: if isActiveMember(circleId);
        allow write: if false;
      }

      match /feedItems/{itemId} {
        allow read: if isActiveMember(circleId) && isGroupCircle(circleId);
        allow write: if false;
      }

      match /threadReads/{uid} {
        allow read: if isSelf(uid) && isGroupCircle(circleId);
        allow write: if false;
      }
    }
  }
}
