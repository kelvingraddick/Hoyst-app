# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'Hoyst' do
  config = use_native_modules!

  use_frameworks! :linkage => :static

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # Static frameworks flatten React Native's source include prefixes.
    # Use iOS headers before the portable C++ fallbacks and retain inherited paths.
    react_common_root = File.expand_path(File.join(config[:reactNativePath], 'ReactCommon'), __dir__)
    namespace_roots = Dir.glob(File.join(react_common_root, '**', '{ReactCommon,react}'))
      .select { |path| File.directory?(path) && !path.include?('/android/') && !path.include?('/samples/') }
      .map { |path| File.dirname(path) }
    header_roots = [react_common_root, *namespace_roots,
      File.join(react_common_root, 'yoga'), File.join(react_common_root, 'jsi'),
      File.join(react_common_root, 'jsiexecutor')].uniq
      .sort_by { |path| path.include?('/platform/ios') ? 0 : path.include?('/platform/cxx') ? 2 : 1 }
    react_header_paths = header_roots.map do |path|
      '"$(PODS_ROOT)/../../node_modules/react-native/ReactCommon' + path.delete_prefix(react_common_root) + '"'
    end
    add_react_header_paths = lambda do |target|
      target.build_configurations.each do |build_config|
        paths = Array(build_config.build_settings['HEADER_SEARCH_PATHS'] || ['$(inherited)'])
        react_header_paths.each { |path| paths << path unless paths.include?(path) }
        build_config.build_settings['HEADER_SEARCH_PATHS'] = paths
      end
    end
    installer.aggregate_targets.map(&:user_project).compact.uniq.each do |project|
      project.native_targets.select { |target| target.name == 'Hoyst' }.each do |target|
        add_react_header_paths.call(target)
      end
      project.save
    end
    installer.pods_project.targets.each do |target|
      add_react_header_paths.call(target) unless target.name == 'OneSignalXCFramework'

      next unless target.name == 'fmt'

      target.build_configurations.each do |build_config|
        definitions = build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
        definitions = Array(definitions)
        definitions << 'FMT_USE_CONSTEVAL=0' unless definitions.include?('FMT_USE_CONSTEVAL=0')
        build_config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = definitions
      end
    end

    fmt_base = File.join(installer.sandbox.pod_dir('fmt'), 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      fmt_contents = File.read(fmt_base)
      patched_contents = fmt_contents.gsub(/^#  define FMT_USE_CONSTEVAL 1$/, '#  define FMT_USE_CONSTEVAL 0')
      if patched_contents != fmt_contents
        File.chmod(0644, fmt_base)
        File.write(fmt_base, patched_contents)
      end
    end
  end
end

target 'OneSignalNotificationServiceExtension' do
  use_frameworks! :linkage => :static

  pod 'OneSignalXCFramework', '>= 5.0.0', '< 6.0'
end
